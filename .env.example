# Metsästäjä-akatemia — ympäristömuuttujat (Coolify → Environment Variables)
# Kopioi arvot Coolifyn resurssin asetuksiin. Kaikki ovat valinnaisia.

# HTTP-portti, jolla palvelin kuuntelee kontin sisällä.
# Coolify: jätä oletus; Coolify ohjaa liikenteen tähän porttiin (Exposed Port 3001).
PORT=3001

# Sidonta — kontissa aina 0.0.0.0.
HOST=0.0.0.0

# Pysyvä tallennuskansio (JSON-profiilit + admin-uploadit).
# Kytkä sama polku pysyvään volumeen Coolifyssa: "Persistent Storage" → /app/data-storage.
DATA_DIR=/app/data-storage

# Fastify-lokin taso: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
